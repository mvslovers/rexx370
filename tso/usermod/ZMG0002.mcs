++USERMOD(ZMG0002)      /* REXX/370 TSO INTEGRATION */ .
++VER(Z038) FMID(EBB1102) PRE(UY16532,UY13431)
 /*
   PROBLEM DESCRIPTION:
     TSO ON MVS 3.8J HAS NO REXX.  THIS USERMOD LETS THE TSO
     TERMINAL MONITOR PROGRAM AND THE EXEC COMMAND RUN REXX EXECS
     THROUGH REXX/370 (GITHUB.COM/MVSLOVERS/REXX370).

     IKJEFT01 (TMP) CALLS THE NEW CSECT IKJEFTRX AT START-UP, WHICH
       CREATES THE REXX LANGUAGE PROCESSOR ENVIRONMENT FOR THE
       SESSION AND ANCHORS IT IN ECTENVBK.
     IKJCT430 (EXEC) ASKS THE NEW CSECT IKJCT437 WHETHER AN EXEC IS
       REXX AND LETS IT RUN THE EXEC IF SO:
       IMPLICIT (%NAME OR NAME): A MEMBER FOUND IN SYSEXEC IS REXX;
         A MEMBER FOUND IN SYSPROC IS REXX ONLY IF LINE 1 IS A
         COMMENT CONTAINING "REXX", OTHERWISE A CLIST.
       EXPLICIT EXEC 'DS(MEMBER)': REXX IF LINE 1 IS SUCH A
         COMMENT, WHATEVER LIBRARY THE DATA SET IS; OTHERWISE A
         CLIST.
       EXPLICIT EXEC ... EXEC: THE NEW EXEC KEYWORD (ABBREVIATIONS
         E, EX, EXE) RUNS THE MEMBER AS REXX.  AN UNQUALIFIED NAME
         THEN GETS THE SUFFIX .EXEC INSTEAD OF .CLIST.
       THESE ARE THE TSO/E RULES AS MEASURED ON Z/OS.
     WITHOUT A REXX ENVIRONMENT EVERYTHING RUNS AS A CLIST.

   SPECIAL CONDITIONS:
     ACTION:
       A "CLPA" MUST BE PERFORMED AT IPL TIME FOR THE TMP PART OF
       THIS SYSMOD TO BECOME ACTIVE.  THE EXEC PART (SYS1.CMDLIB)
       IS ACTIVE AT ONCE; UNTIL THE CLPA IT RUNS UNDER THE OLD TMP,
       FINDS NO REXX ENVIRONMENT AND BEHAVES LIKE THE IBM EXEC.
     ACTION:
       BACK UP SYS1.LPALIB(IKJEFT01,IKJEFT0A) AND
       SYS1.CMDLIB(EXEC,EX) BEFORE THE APPLY.  DO NOT ACCEPT THIS
       SYSMOD.
     DEPENDENCY:
       REXX/370 MUST BE INSTALLED IN THE LINK LIST (IRXANCHR,
       IRXINIT, IRXTERM, IRXEXEC, IRXTSPRM, IRXIOTSO, IRXLDTSO), AT
       A LEVEL THAT CONTAINS REXX370 #239: OLDER LEVELS ABEND S0C1
       IN REXX EXECS AFTER CLISTS HAVE RUN IN THE SESSION.  WITHOUT
       REXX/370 THE TMP CREATES NO ENVIRONMENT AND EXEC STAYS
       CLIST-ONLY.
     PREREQUISITES:
       UY16532 (IKJCT430) AND UY13431 (IKJEFT01): THE OBJECT DECKS
       SHIPPED HERE ARE THOSE LEVELS PLUS THE REXX/370 HOOKS.  THE
       REST OF BOTH LOAD MODULES IS KEPT AS INSTALLED.
     RESTRICTION:
       AN EXPLICIT EXEC OF A SEQUENTIAL DATA SET ALWAYS RUNS AS A
       CLIST; REXX EXECS MUST BE PDS MEMBERS.

   COMMENTS:
     REXX/370 TSO INTEGRATION, MVSLOVERS, BY MIKE GROSSMANN.

     THE FOLLOWING MODULES ARE AFFECTED BY THIS USERMOD:
     MODULES:
       IKJEFT01  IKJEFTRX (NEW)  IKJCT430  IKJCT437 (NEW)
     LOAD MODULES:
       IKJEFT01 (SYS1.LPALIB)   EXEC (SYS1.CMDLIB)
 */ .
++JCLIN .
//ZMGLK01  EXEC PGM=IEWL,PARM='LIST,XREF,LET,RENT,REUS'
//SYSPRINT DD  SYSOUT=*
//AOST4    DD  DISP=SHR,DSN=SYS1.AOST4
//SYSLMOD  DD  DISP=SHR,DSN=SYS1.LPALIB
//SYSLIN   DD  *
  ORDER IKJEFT01(P)
  ORDER IKJEFT06
  INCLUDE AOST4(IKJEFT01,IKJEFT06,IKJEFTSC,IKJEFTRX)
  ALIAS IKJEFT0A
  ENTRY IKJEFT01
  SETCODE AC(1)
  NAME IKJEFT01(R)
/*
//ZMGLK02  EXEC PGM=IEWL,PARM='LIST,XREF,LET,RENT,REUS'
//SYSPRINT DD  SYSOUT=*
//AOST4    DD  DISP=SHR,DSN=SYS1.AOST4
//SYSLMOD  DD  DISP=SHR,DSN=SYS1.CMDLIB
//SYSLIN   DD  *
  ORDER IKJCT431,IKJCT430,PARS,IKJCT432,IKJCT435,IKJCT437
  INCLUDE AOST4(IKJCT430,IKJCT431,IKJCT432,IKJCT435,IKJCT437)
  ENTRY IKJCT430
  ALIAS EX
  NAME EXEC(R)
/*
++MOD(IKJEFT01) DISTLIB(AOST4) .
<<DECK IKJEFT01>>
++MOD(IKJEFTRX) DISTLIB(AOST4) .
<<DECK IKJEFTRX>>
++MOD(IKJCT430) DISTLIB(AOST4) .
<<DECK IKJCT430>>
++MOD(IKJCT437) DISTLIB(AOST4) .
<<DECK IKJCT437>>
