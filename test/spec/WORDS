/* REXX -- WORDS conformance, SC28-1883-0 p.108                      */
/* Cases: examples of SC28-1883-0 and brexx370 test/words.rexx       */
/* (CMS-370-BREXX, Unlicense), expectations checked against the      */
/* 1988 manual. See internals/spec-tests/words.md.                   */
fails = 0
call t 1, words('Now is the time'), '4'
call t 2, words(' '), '0'
call t 3, words('This is certainly a test'), '5'
call t 4, words(' This is certainly a test'), '5'
call t 5, words('This is certainly a test '), '5'
call t 6, words(' hepp '), '1'
call t 7, words(' hepp hepp '), '2'
call t 8, words(''), '0'
say 'WORDS    done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison             */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'WORDS   ' right(n,3) 'PASS'
else do
  say 'WORDS   ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                            */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'WORDS   ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
