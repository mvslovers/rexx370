/* REXX -- COMPARE conformance, SC28-1883-0 p.82                      */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/compare.rexx (CMS-370-BREXX, Unlicense), expectations         */
/* checked against the 1988 manual.                                   */
/* See internals/spec-tests/strings.md.                               */
fails = 0
call t 1, compare('abc','abc'), '0'
call t 2, compare('abc','ak'), '2'
call t 3, compare('ab ','ab'), '0'
call t 4, compare('ab ','ab',' '), '0'
call t 5, compare('ab ','ab','x'), '3'
call t 6, compare('ab-- ','ab','-'), '5'
call t 7, compare('foo','bar'), '1'
call t 8, compare('foo','foo'), '0'
call t 9, compare(' ',''), '0'
call t 10, compare('foo','f','o'), '0'
call t 11, compare('foobar','foobag'), '6'
say 'COMPARE  done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'COMPARE ' right(n,3) 'PASS'
else do
  say 'COMPARE ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'COMPARE ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
