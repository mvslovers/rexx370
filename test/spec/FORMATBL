/* REXX -- FORMATBL conformance, SC28-1883-0 p.91                   */
/* Cases: examples of SC28-1883-0 and brexx370 test/format.rexx     */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/numeric.md.                */
fails = 0
/* FORMAT with blanks around the sign (split from FORMAT, see doc) */
call t 1, format(' - 12.73',,4), '-12.7300'
call t 2, format(' - 12.73'), '-12.73'
numeric digits 3
v = format(' - 12.73')
numeric digits 9
call t 3, v, '-12.7'
numeric digits 3
v = format(' - 12.73',,4)
numeric digits 9
call t 4, v, '-12.7000'
say 'FORMATBL done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'FORMATBL' right(n,3) 'PASS'
else do
  say 'FORMATBL' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'FORMATBL' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
