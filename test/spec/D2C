/* REXX -- D2C conformance, SC28-1883-0 p.88                        */
/* Cases: examples of SC28-1883-0 and brexx370 test/d2c.rexx        */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/conversion.md.             */
fails = 0
call t 1, c2x(d2c(9)), '09'
call t 2, c2x(d2c(129)), '81'
call t 3, c2x(d2c(129,1)), '81'
call t 4, c2x(d2c(129,2)), '0081'
call t 5, c2x(d2c(257,1)), '01'
call t 6, c2x(d2c(-127,1)), '81'
call t 7, c2x(d2c(-127,2)), 'FF81'
call t 8, c2x(d2c(-1,4)), 'FFFFFFFF'
call t 9, c2x(d2c(12,0)), ''
call t 10, c2x(d2c(127)), '7F'
call t 11, c2x(d2c(128)), '80'
call t 12, c2x(d2c(1)), '01'
call t 13, c2x(d2c(-1,1)), 'FF'
call t 14, c2x(d2c(-128,1)), '80'
call t 15, c2x(d2c(-129,1)), '7F'
call t 16, c2x(d2c(-1,2)), 'FFFF'
call t 17, c2x(d2c(-128,2)), 'FF80'
call t 18, c2x(d2c(-129,2)), 'FF7F'
call t 19, c2x(d2c(129,0)), ''
call t 20, c2x(d2c(256+129,2)), '0181'
call t 21, c2x(d2c(256*256+256+129,3)), '010181'
call t 22, c2x(d2c(0)), '00'
call t 23, length(d2c(0)), '1'
say 'D2C      done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'D2C     ' right(n,3) 'PASS'
else do
  say 'D2C     ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'D2C     ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
