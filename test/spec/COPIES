/* REXX -- COPIES conformance, SC28-1883-0 p.83                       */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/copies.rexx (CMS-370-BREXX, Unlicense), expectations          */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, copies('abc',3), 'abcabcabc'
call t 2, copies('abc',0), ''
call t 3, copies('foo',3), 'foofoofoo'
call t 4, copies('x',10), 'xxxxxxxxxx'
call t 5, copies('',50), ''
call t 6, copies('',0), ''
call t 7, copies('foobar',0), ''
say 'COPIES   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'COPIES  ' right(n,3) 'PASS'
else do
  say 'COPIES  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'COPIES  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
