/* REXX -- WORDINDEX conformance, SC28-1883-0 p.107                  */
/* Cases: examples of SC28-1883-0 and brexx370 test/wordind.rexx     */
/* (CMS-370-BREXX, Unlicense), expectations checked against the      */
/* 1988 manual. See internals/spec-tests/words.md.                   */
fails = 0
call t 1, wordindex('Now is the time',3), '8'
call t 2, wordindex('Now is the time',6), '0'
call t 3, wordindex('This is certainly a test',1), '1'
call t 4, wordindex('  This is certainly a test',1), '3'
call t 5, wordindex('This   is certainly a test',1), '1'
call t 6, wordindex('  This   is certainly a test',1), '3'
call t 7, wordindex('This is certainly a test',2), '6'
call t 8, wordindex('This   is certainly a test',2), '8'
call t 9, wordindex('This is   certainly a test',2), '6'
call t 10, wordindex('This   is   certainly a test',2), '8'
call t 11, wordindex('This is certainly a test',5), '21'
call t 12, wordindex('This is certainly a   test',5), '23'
call t 13, wordindex('This is certainly a test  ',5), '21'
call t 14, wordindex('This is certainly a test  ',6), '0'
call t 15, wordindex('This is certainly a test',6), '0'
call t 16, wordindex('This is certainly a test',7), '0'
call t 17, wordindex('This is certainly a test  ',7), '0'
say 'WORDINDX done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison             */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'WORDINDX' right(n,3) 'PASS'
else do
  say 'WORDINDX' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                            */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'WORDINDX' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
