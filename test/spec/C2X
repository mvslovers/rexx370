/* REXX -- C2X conformance, SC28-1883-0 p.84                        */
/* Cases: examples of SC28-1883-0 and brexx370 test/c2x.rexx        */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/conversion.md.                  */
fails = 0
call te 1, c2x('72s'), 'F7F2A2'
call t 2, c2x('0123'X), '0123'
call te 3, c2x('foobar'), '869696828199'
call t 4, c2x(''), ''
call t 5, c2x('0123456789abcdef'x), '0123456789ABCDEF'
call t 6, c2x('ffff'x), 'FFFF'
call t 7, c2x('ffffffff'x), 'FFFFFFFF'
say 'C2X      done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'C2X     ' right(n,3) 'PASS'
else do
  say 'C2X     ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'C2X     ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
