call t 42, ('1E1' = 10), '1'
numeric digits 5
c1 = (12345678 = 12345679)
c2 = (2/3 = 0.66667)
numeric digits 9
call t 43, c1, '1'
call t 44, c2, '1'
say 'ARITH    done, failed:' fails
