/* REXX -- BITXOR conformance, SC28-1883-0 p.81                     */
/* Cases: examples of SC28-1883-0 and brexx370 test/bitxor.rexx     */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/conversion.md.             */
fails = 0
call t 1, c2x(bitxor('12'x,'22'x)), '30'
call t 2, c2x(bitxor('1211'x,'22'x)), '3011'
call te 3, c2x(bitxor('C711'x,'222222'x,' ')), 'E53362'
call t 4, c2x(bitxor('1111'x,'444444'x)), '555544'
call t 5, c2x(bitxor('1111'x,'444444'x,'40'x)), '555504'
call t 6, c2x(bitxor('1111'x,,'4D'x)), '5C5C'
call t 7, c2x(bitxor('123456'x,'3456'x)), '266256'
call t 8, c2x(bitxor('3456'x,'123456'x,'99'x)), '2662CF'
call t 9, c2x(bitxor('123456'x,,'55'x)), '476103'
call t 10, bitxor('foobar'), 'foobar'
call te 11, bitxor('FooBar',,'40'x), 'fOObAR'
say 'BITXOR   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'BITXOR  ' right(n,3) 'PASS'
else do
  say 'BITXOR  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'BITXOR  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
