/* REXX -- BITAND conformance, SC28-1883-0 p.80                     */
/* Cases: examples of SC28-1883-0 and brexx370 test/bitand.rexx     */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/conversion.md.             */
fails = 0
call t 1, c2x(bitand('73'x,'27'x)), '23'
call t 2, c2x(bitand('13'x,'5555'x)), '1155'
call t 3, c2x(bitand('13'x,'5555'x,'74'x)), '1154'
call te 4, bitand('pQrS',,'BF'x), 'pqrs'
call t 5, c2x(bitand('123456'x,'3456'x)), '101456'
call t 6, c2x(bitand('3456'x,'123456'x,'99'x)), '101410'
call t 7, c2x(bitand('123456'x,,'55'x)), '101454'
call t 8, bitand('foobar'), 'foobar'
call te 9, bitand('FOOBAR',,'BF'x), 'foobar'
say 'BITAND   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'BITAND  ' right(n,3) 'PASS'
else do
  say 'BITAND  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'BITAND  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
