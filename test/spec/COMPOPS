/* REXX -- comparison conformance, SC28-1883-0 p.14-17, 145         */
/* Cases: examples of SC28-1883-0 and brexx370 test/equal.rexx      */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/language.md.                    */
fails = 0
/* examples of p.17 */
a = '3'
call t 1, (a+1)>7, '0'
call t 2, ' ' = '', '1'
call t 3, ' ' == '', '0'
call t 4, ' ' \== '', '1'
call t 5, (a+1)*3=12, '1'
call t 6, 'abc' << 'abd', '1'
call t 7, '077' >> '11', '0'
call t 8, 'abc' >> 'ab', '1'
call t 9, 'ab ' << 'abd', '1'
call te 10, '000000' >> '0E0000', '1'
call t 11, '000000' > '0E0000', '0'
/* brexx equal.rexx: leading/trailing blanks ignored, p.14 */
call t 12, 'abc  ' = 'abc', '1'
call t 13, 'abc' = 'abc  ', '1'
call t 14, '  abc  ' = 'abc', '1'
call t 15, 'abc  ' \= 'abc', '0'
call t 16, 'abc  ' == 'abc', '0'
call t 17, 'abc ' > 'abc', '0'
call t 18, 'abc ' >= 'abc', '1'
call t 19, 'abc ' < 'abd', '1'
call t 20, 'ab  c' > 'ab', '1'
call t 21, 'a b' = 'a  b', '0'
call t 22, 'ab x' < 'abcx', '1'
call t 23, 'ab' < 'ab  c', '1'
call t 24, left('END',80) = 'END', '1'
call t 25, '1 ' = 1, '1'
/* numeric comparison when both terms are numbers, p.14 */
call t 26, '1.0' = 1, '1'
call t 27, '1.0' == 1, '0'
call t 28, ' 12 ' = '12.00', '1'
call t 29, '1e2' = 100, '1'
call t 30, '10' > '9', '1'
call t 31, '10' >> '9', '0'
call t 32, '-1' < '0', '1'
call t 33, '+5' \= '5', '0'
/* every operator of p.14-15 once */
call t 34, 'a' = 'a ', '1'
call t 35, 'a' \= 'b', '1'
call t 36, 'b' > 'a', '1'
call t 37, 'a' < 'b', '1'
call t 38, 'a' >< 'b', '1'
call t 39, 'a' <> 'a ', '0'
call t 40, 'a' >= 'a', '1'
call t 41, 'a' <= 'b', '1'
call t 42, 'a' \< 'b', '0'
call t 43, 'a' \> 'b', '1'
call t 44, 'b ' >> 'b', '1'
call t 45, 'b' << 'b ', '1'
call t 46, 'b' >>= 'b', '1'
call t 47, 'a' <<= 'b', '1'
call t 48, ' a' \== 'a', '1'
/* EBCDIC order: lowercase before uppercase, digits last, p.14 */
call te 49, 'a' < 'A', '1'
call te 50, 'Z' < '0', '1'
call te 51, 'z' < '9', '1'
call te 52, 'a' << 'A', '1'
/* FUZZ, p.145 */
numeric digits 5
numeric fuzz 0
call t 53, 4.9999 = 5, '0'
call t 54, 4.9999 < 5, '1'
numeric fuzz 1
call t 55, 4.9999 = 5, '1'
call t 56, 4.9999 < 5, '0'
numeric fuzz 0
numeric digits 9
/* logical operators, p.15 */
call t 57, 1 & 1, '1'
call t 58, 1 & 0, '0'
call t 59, 0 | 1, '1'
call t 60, 0 | 0, '0'
call t 61, 1 && 1, '0'
call t 62, 1 && 0, '1'
call t 63, \1, '0'
call t 64, \0, '1'
call t 65, (1 = 1) & ('a' < 'b'), '1'
say 'COMPOPS  done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'COMPOPS ' right(n,3) 'PASS'
else do
  say 'COMPOPS ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'COMPOPS ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
