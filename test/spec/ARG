/* REXX -- ARG conformance, SC28-1883-0 p.30, 33, 79                */
/* Cases: examples of SC28-1883-0 and brexx370 test/arg.rexx        */
/* and test/argval.rexx                                             */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/language.md.               */
fails = 0
/* "Call name;" (no arguments), p.79 */
call name
call t 1, r.1, '0'
call t 2, r.2, ''
call t 3, r.3, ''
call t 4, r.4, '0'
call t 5, r.5, '1'
/* "Call name 'a',,'b';", p.79 */
call namex 'a',,'b'
call t 6, r.1, '3'
call t 7, r.2, 'a'
call t 8, r.3, ''
call t 9, r.4, 'b'
call t 10, r.5, ''
call t 11, r.6, ''
call t 12, r.7, '1'
call t 13, r.8, '0'
call t 14, r.9, '1'
call t 15, r.10, '0'
call t 16, r.11, '1'
/* brexx arg.rexx 6-15: "call namex 1,,2" */
call namex 1,,2
call t 17, r.1 r.2 '/'r.3'/' r.4, '3 1 // 2'
call t 18, r.5 r.6, ' '
call t 19, r.7 r.8 r.9 r.10 r.11, '1 0 1 0 1'
/* the same through a function call */
call t 20, fna('a',,'b'), '3 a  b 1 0 1'
call t 21, fna(), '0    0 0 1'
/* arguments are passed by value, p.33 (brexx argval.rexx) */
x = 'old'
call chg x
call t 22, result, 'old'
call t 23, x, 'new'
x = 'old'
call t 24, chg(x), 'old'
x = 'old'; y = 'yold'
call t 25, chg2(x, y), 'old yold'
x = 'old'
call t 26, chg3(x,,x), 'old 0 old'
x = 'old'
call t 27, chg4(x), 'old'
/* the ARG instruction uppercases, p.30 */
call easy 'Easy Rider'
call t 28, adjective, 'EASY'
call t 29, noun, 'RIDER'
call t 30, fred('data X',1,5), 'DATA X/1/5'
/* ARG may be run again on the same strings, p.30 */
call twice 'a b'
call t 31, result, 'A B|a b'
/* a continuation comma is replaced by a blank, p.12 */
call cnt 1,,
  2
call t 32, result, '2'
call cnt 1,
  , 2
call t 33, result, '2'
say 'ARG      done, failed:' fails
exit fails

name:
r.1 = arg(); r.2 = arg(1); r.3 = arg(2)
r.4 = arg(1,'e'); r.5 = arg(1,'O')
return
namex:
r.1 = arg(); r.2 = arg(1); r.3 = arg(2); r.4 = arg(3); r.5 = arg(4)
r.6 = arg(99)
r.7 = arg(1,'e'); r.8 = arg(2,'E'); r.9 = arg(2,'O')
r.10 = arg(3,'o'); r.11 = arg(4,'o')
return
fna:
return arg() arg(1) arg(2) arg(3) arg(1,'E') arg(2,'E') arg(2,'O')
chg:  x = 'new'
      return arg(1)
chg2: x = 'new'; y = 'ynew'
      return arg(1) arg(2)
chg3: x = 'new'
      return arg(1) arg(2,'E') arg(3)
chg4: x = 'new'
      parse arg v
      return v
easy: arg adjective noun .
return
fred: arg string, num1, num2
return string'/'num1'/'num2
twice: arg w1 w2
parse arg l1 l2
return w1 w2'|'l1 l2
cnt: return arg()

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'ARG     ' right(n,3) 'PASS'
else do
  say 'ARG     ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'ARG     ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
