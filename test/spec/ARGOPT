/* REXX -- ARG options conformance, SC28-1883-0 p.79                */
/* Cases: examples of SC28-1883-0 and brexx370 test/arg.rexx        */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/language.md.                    */
fails = 0
/* only the capital letter of the option counts, p.79 */
call t 1, opt('x',,'y'), '1 1 0 1 0'
/* a null string is an argument that exists */
call t 2, opt(''), '1 1 0 1 1'
say 'ARGOPT   done, failed:' fails
exit fails

opt:
return arg(1,'Exists') arg(1,'exists') arg(2,'Exist'),
  arg(2,'Omitted') arg(3,'omit')

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'ARGOPT  ' right(n,3) 'PASS'
else do
  say 'ARGOPT  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'ARGOPT  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
