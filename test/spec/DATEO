/* REXX -- DATE('O') conformance, SC28-1883-0 p.86                  */
/* Cases: examples of SC28-1883-0 and brexx370 test/date.rexx       */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/language.md.               */
fails = 0
/* Ordered: yy/mm/dd, one expression uses one time stamp, p.86 */
ok = date('O') == substr(date('S'),3,2)'/'substr(date('S'),5,2)'/'||,
  substr(date('S'),7,2)
call t 1, ok, '1'
ok = date('Ordered') == date('O')
call t 2, ok, '1'
say 'DATEO    done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'DATEO   ' right(n,3) 'PASS'
else do
  say 'DATEO   ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'DATEO   ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
