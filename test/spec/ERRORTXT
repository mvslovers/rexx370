/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'ERRORTXT' right(n,3) 'PASS'
else do
  say 'ERRORTXT' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'ERRORTXT' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
