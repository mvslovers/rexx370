/* REXX -- XRANGE hex conformance, SC28-1883-0 p.108                  */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/xrange.rexx (CMS-370-BREXX, Unlicense), expectations          */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, xrange('03'x,'07'x), '0304050607'x
call t 2, xrange(,'04'x), '0001020304'x
call te 3, xrange('i','j'), '898A8B8C8D8E8F9091'x
call t 4, xrange('FE'x,'02'x), 'FEFF000102'x
call t 5, xrange('7D'x,'83'x), '7D7E7F80818283'x
call te 6, xrange('f','r'), 'fghi'||'8A8B8C8D8E8F90'x||'jklmnopqr'
say 'XRANGEHX done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'XRANGEHX' right(n,3) 'PASS'
else do
  say 'XRANGEHX' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'XRANGEHX' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
