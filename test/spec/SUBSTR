/* REXX -- SUBSTR conformance, SC28-1883-0 p.100                      */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/substr.rexx (CMS-370-BREXX, Unlicense), expectations          */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, substr('abc',2), 'bc'
call t 2, substr('abc',2,4), 'bc  '
call t 3, substr('abc',2,6,'.'), 'bc....'
call t 4, substr('foobar',2,3), 'oob'
call t 5, substr('foobar',3), 'obar'
call t 6, substr('foobar',3,6), 'obar  '
call t 7, substr('foobar',3,6,'*'), 'obar**'
call t 8, substr('foobar',6,3), 'r  '
call t 9, substr('foobar',8,3), '   '
say 'SUBSTR   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'SUBSTR  ' right(n,3) 'PASS'
else do
  say 'SUBSTR  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'SUBSTR  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
