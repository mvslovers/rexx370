/* REXX -- WORDLENGTH conformance, SC28-1883-0 p.107                 */
/* Cases: examples of SC28-1883-0 and brexx370 test/wordlen.rexx     */
/* (CMS-370-BREXX, Unlicense), expectations checked against the      */
/* 1988 manual. See docs/spec-tests/words.md.                        */
fails = 0
call t 1, wordlength('Now is the time',2), '2'
call t 2, wordlength('Now comes the time',2), '5'
call t 3, wordlength('Now is the time',6), '0'
call t 4, wordlength('This is certainly a test',1), '4'
call t 5, wordlength('This is certainly a test',2), '2'
call t 6, wordlength('This is certainly a test',5), '4'
call t 7, wordlength('This is certainly a test ',5), '4'
call t 8, wordlength('This is certainly a test',6), '0'
call t 9, wordlength('',1), '0'
call t 10, wordlength('',10), '0'
say 'WORDLEN  done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison             */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'WORDLEN ' right(n,3) 'PASS'
else do
  say 'WORDLEN ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                            */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'WORDLEN ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
