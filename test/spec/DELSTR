/* REXX -- DELSTR conformance, SC28-1883-0 p.87                       */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/delstr.rexx (CMS-370-BREXX, Unlicense), expectations          */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, delstr('abcd',3), 'ab'
call t 2, delstr('abcde',3,2), 'abe'
call t 3, delstr('abcde',6), 'abcde'
call t 4, delstr('Med lov skal land bygges',6), 'Med l'
call t 5, delstr('Med lov skal land bygges',6,10), 'Med lnd bygges'
call t 6, delstr('Med lov skal land bygges',1), ''
call t 7, delstr('Med lov skal',30), 'Med lov skal'
call t 8, delstr('Med lov skal',8,8), 'Med lov'
call t 9, delstr('Med lov skal',12), 'Med lov ska'
call t 10, delstr('Med lov skal',13), 'Med lov skal'
call t 11, delstr('Med lov skal',14), 'Med lov skal'
call t 12, delstr('',30), ''
say 'DELSTR   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'DELSTR  ' right(n,3) 'PASS'
else do
  say 'DELSTR  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'DELSTR  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
