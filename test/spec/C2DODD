/* REXX -- C2DODD conformance, SC28-1883-0 p.83                     */
/* Cases: examples of SC28-1883-0 and brexx370 test/c2d.rexx        */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/conversion.md.             */
fails = 0
call t 1, c2d('a'x), '10'
call t 2, c2d('101'x), '257'
say 'C2DODD   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'C2DODD  ' right(n,3) 'PASS'
else do
  say 'C2DODD  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'C2DODD  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
