/* REXX -- SPACE conformance, SC28-1883-0 p.99                        */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/space.rexx (CMS-370-BREXX, Unlicense), expectations           */
/* checked against the 1988 manual.                                   */
/* See internals/spec-tests/strings.md.                               */
fails = 0
call t 1, space('abc  def  '), 'abc def'
call t 2, space('  abc def',3), 'abc   def'
call t 3, space('abc  def  ',1), 'abc def'
call t 4, space('abc  def  ',0), 'abcdef'
call t 5, space('abc  def  ',2,'+'), 'abc++def'
call t 6, space(' foo '), 'foo'
call t 7, space(' foo'), 'foo'
call t 8, space('foo '), 'foo'
call t 9, space(' foo bar '), 'foo bar'
call t 10, space(' foo bar ',2), 'foo  bar'
call t 11, space(' foo bar ',,'-'), 'foo-bar'
call t 12, space(' foo bar ',2,'-'), 'foo--bar'
call t 13, space(' f-- b-- ',2,'-'), 'f----b--'
call t 14, space(' f o o b a r ',0), 'foobar'
say 'SPACE    done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'SPACE   ' right(n,3) 'PASS'
else do
  say 'SPACE   ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'SPACE   ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
