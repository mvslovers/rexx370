/* REXX -- FIND conformance, SC28-1883-0 p.90                        */
/* Cases: examples of SC28-1883-0 and rules of its p.90 text         */
/* (no brexx370 test exists). See docs/spec-tests/words.md.          */
fails = 0
call t 1, find('now is the time','is the time'), '2'
call t 2, find('now is  the time','is    the'), '2'
call t 3, find('now is  the time','is  time '), '0'
call t 4, find('now is the time',''), '0'
call t 5, find('now is the time','  '), '0'
say 'FIND     done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison             */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'FIND    ' right(n,3) 'PASS'
else do
  say 'FIND    ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                            */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'FIND    ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
