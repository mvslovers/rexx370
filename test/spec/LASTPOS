/* REXX -- LASTPOS conformance, SC28-1883-0 p.93                      */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/lastpos.rexx (CMS-370-BREXX, Unlicense), expectations         */
/* checked against the 1988 manual.                                   */
/* See internals/spec-tests/strings.md.                               */
fails = 0
call t 1, lastpos(' ','abc def ghi'), '8'
call t 2, lastpos(' ','abcdefghi'), '0'
call t 3, lastpos(' ','abc def ghi',7), '4'
call t 4, lastpos('b','abc abc'), '6'
call t 5, lastpos('b','abc abc',5), '2'
call t 6, lastpos('b','abc abc',6), '6'
call t 7, lastpos('b','abc abc',7), '6'
call t 8, lastpos('x','abc abc'), '0'
call t 9, lastpos('b','abc abc',20), '6'
call t 10, lastpos('b',''), '0'
call t 11, lastpos('bc','abc abc'), '6'
call t 12, lastpos('bc ','abc abc',20), '2'
call t 13, lastpos('abc','abc abc'), '5'
call t 14, lastpos('abc','abc abc',7), '5'
say 'LASTPOS  done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'LASTPOS ' right(n,3) 'PASS'
else do
  say 'LASTPOS ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'LASTPOS ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
