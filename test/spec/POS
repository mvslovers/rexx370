/* REXX -- POS conformance, SC28-1883-0 p.96                          */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/pos.rexx (CMS-370-BREXX, Unlicense), expectations             */
/* checked against the 1988 manual.                                   */
/* See internals/spec-tests/strings.md.                               */
fails = 0
call t 1, pos('day','Saturday'), '6'
call t 2, pos('x','abc def ghi'), '0'
call t 3, pos(' ','abc def ghi'), '4'
call t 4, pos(' ','abc def ghi',5), '8'
call t 5, pos('foo','a foo foo b'), '3'
call t 6, pos('foo','a foo foo',3), '3'
call t 7, pos('foo','a foo foo',4), '7'
call t 8, pos('foo','a foo foo b',30), '0'
call t 9, pos('foo','a foo foo b',1), '3'
call t 10, pos('foo',''), '0'
call t 11, pos('b','a'), '0'
call t 12, pos('b','b'), '1'
call t 13, pos('b','abc'), '2'
call t 14, pos('b','def'), '0'
call t 15, pos('foo','foo foo b'), '1'
call t 16, pos('abc','abcdefabccdabcd',4), '7'
say 'POS      done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'POS     ' right(n,3) 'PASS'
else do
  say 'POS     ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'POS     ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
