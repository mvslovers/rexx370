/* REXX -- MAX conformance, SC28-1883-0 p.95                        */
/* Cases: examples of SC28-1883-0 and brexx370 test/max.rexx        */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/numeric.md.                     */
fails = 0
call t 1, max(12,6,7,9), '12'
call t 2, max(17.3,19,17.03), '19'
call t 3, max(-7,-3,-4.3), '-3'
call t 4, max(1,2,3,4,5,6,7,8,9,max(10,11,12,13)), '13'
call t 5, max( 10.1 ), '10.1'
call t 6, max( -10.1, 3.8 ), '3.8'
call t 7, max( 10.1, 10.2, 10.3 ), '10.3'
call t 8, max( 10.3, 10.2, 10.3 ), '10.3'
call t 9, max( 10.1, 10.4, 10.3 ), '10.4'
call t 10, max( 10.3, 10.2, 10.1 ), '10.3'
call t 11, max( 1, 2, 4, 5 ), '5'
call t 12, max( -0, 0 ), '0'
call t 13, max( 1,2,3,4,5,6,7,8,7,6,5,4,3,2 ), '8'
numeric digits 3
v = max(1.234, 1)
numeric digits 9
call t 14, v, '1.23'
say 'MAX      done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'MAX     ' right(n,3) 'PASS'
else do
  say 'MAX     ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'MAX     ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
