/* REXX -- FORM conformance, SC28-1883-0 p.90                       */
/* Cases: examples of SC28-1883-0 and brexx370 test/form.rexx       */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/numeric.md.                */
fails = 0
call t 1, form(), 'SCIENTIFIC'
numeric form engineering
v = form()
numeric form scientific
call t 2, v, 'ENGINEERING'
call t 3, form(), 'SCIENTIFIC'
/* last: NUMERIC FORM VALUE / FORM (expr) end the exec today */
numeric form value 'SCIENTIFIC'
call t 4, form(), 'SCIENTIFIC'
numeric form ('ENGIN' || 'EERING')
v = form()
numeric form scientific
call t 5, v, 'ENGINEERING'
say 'FORM     done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'FORM    ' right(n,3) 'PASS'
else do
  say 'FORM    ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'FORM    ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
