/* REXX -- STRIP conformance, SC28-1883-0 p.100                       */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/strip.rexx (CMS-370-BREXX, Unlicense), expectations           */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, strip('  ab c  '), 'ab c'
call t 2, strip('  ab c  ','L'), 'ab c  '
call t 3, strip('  ab c  ','t'), '  ab c'
call t 4, strip('12.7000',,0), '12.7'
call t 5, strip('0012.700',,0), '12.7'
call t 6, strip('0012.7000',,0), '12.7'
call t 7, strip(' foo bar '), 'foo bar'
call t 8, strip(' foo bar ','L'), 'foo bar '
call t 9, strip(' foo bar ','T'), ' foo bar'
call t 10, strip(' foo bar ','B'), 'foo bar'
call t 11, strip(' foo bar ','B','*'), ' foo bar '
call t 12, strip(' foo bar',,'r'), ' foo ba'
say 'STRIP    done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'STRIP   ' right(n,3) 'PASS'
else do
  say 'STRIP   ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'STRIP   ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
