/* REXX -- chained comparison conformance, SC28-1883-0 p.16         */
/* Cases: examples of SC28-1883-0 and brexx370 test/opchain.rexx    */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/language.md.               */
fails = 0
/* operators of equal precedence apply left to right, p.16 */
call t 1, 2=2=2, '0'
call t 2, 1=1=1, '1'
call t 3, 3>2>1, '0'
call t 4, 'a'=='a'==1, '1'
a = 2=2=2
call t 5, a, '0'
call t 6, 1<2<3, '1'
say 'COMPCHN  done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'COMPCHN ' right(n,3) 'PASS'
else do
  say 'COMPCHN ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'COMPCHN ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
