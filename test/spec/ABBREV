/* REXX -- ABBREV conformance, SC28-1883-0 p.78                       */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/abbrev.rexx (CMS-370-BREXX, Unlicense), expectations          */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, abbrev('Print','Pri'), '1'
call t 2, abbrev('PRINT','Pri'), '0'
call t 3, abbrev('PRINT','PRI',4), '0'
call t 4, abbrev('PRINT','PRY'), '0'
call t 5, abbrev('PRINT',''), '1'
call t 6, abbrev('PRINT','',1), '0'
call t 7, abbrev('information','info',4), '1'
call t 8, abbrev('information','',0), '1'
call t 9, abbrev('information','Info',4), '0'
call t 10, abbrev('information','info',5), '0'
call t 11, abbrev('information','info '), '0'
call t 12, abbrev('information','info',3), '1'
call t 13, abbrev('info','information',3), '0'
call t 14, abbrev('info','info',5), '0'
say 'ABBREV   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'ABBREV  ' right(n,3) 'PASS'
else do
  say 'ABBREV  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'ABBREV  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
