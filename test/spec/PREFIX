/* REXX -- prefix operators conformance, SC28-1883-0 p.14-16, 142   */
/* Cases: examples of SC28-1883-0 and brexx370 test/prefix.rexx     */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/language.md.                    */
fails = 0
/* brexx prefix.rexx, without INTERPRET */
b = 0; a = 1
x = -\b
call t 1, x, '-1'
x = +-+-\0
call t 2, x, '1'
x = \\1
call t 3, x, '1'
x = -(-3)
call t 4, x, '3'
x = - -a
call t 5, x, '1'
x = +'1E+2'
call t 6, x, '100'
x = +.1E2
call t 7, x, '10'
x = +5
call t 8, x, '5'
/* prefix minus binds tighter than **, p.16 */
x = -2**2
call t 9, x, '4'
x = 3 - -a
call t 10, x, '4'
/* -v is 0-v: the other number is the result, p.142 */
v = '1.50'
x = -v
call t 11, x, '-1.50'
call t 12, v, '1.50'
/* in 1988 REXX "--" is two prefix operators, not a comment */
x = --a
call t 13, x, '1'
/* more cases of the same rules, p.14 and p.142 */
x = -' 5 '
call t 14, x, '-5'
x = +'1.50'
call t 15, x, '1.50'
x = -'0.00'
call t 16, x, '0'
x = \\0
call t 17, x, '0'
x = -3**2
call t 18, x, '9'
x = -a + 5
call t 19, x, '4'
x = \0 + 1
call t 20, x, '2'
say 'PREFIX   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'PREFIX  ' right(n,3) 'PASS'
else do
  say 'PREFIX  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'PREFIX  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
