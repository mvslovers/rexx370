/* REXX -- SOURCELINE conformance, SC28-1883-0 p.99                 */
/* Cases: examples and rules of SC28-1883-0, expectations           */
/* derived from the 1988 manual only.                               */
/* See internals/spec-tests/language.md.                            */
fails = 0
/* SOURCELINE() is the number of the final line of this file, p.99 */
call t 1, sourceline(), '40'
/* SOURCELINE(n) is line n, p.99 */
l1 = '/* REXX -- SOURCELINE conformance, SC28-1883-0 p.99'
l1 = l1 || copies(' ', 68 - length(l1)) || '*/'
/* strip: a fixed-length record may carry trailing blanks (p.99 */
/* does not say whether they belong to the line)                 */
call t 2, strip(sourceline(1),'T'), l1
mk = 1 /* this is the marker line */
mkl = 'mk = 1 /* this is the marker line */'
call t 3, strip(sourceline(14),'T'), mkl
call t 4, strip(sourceline(sourceline()),'T'), 'return'
call t 5, sourceline(' 1 '), sourceline(1)
say 'SOURCELN done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'SOURCELN' right(n,3) 'PASS'
else do
  say 'SOURCELN' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'SOURCELN' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
