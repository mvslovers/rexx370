/* REXX -- PARSE literal conformance, SC28-1883-0 p.132-135         */
/* Cases: examples of SC28-1883-0 and brexx370 test/parse.rexx      */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/language.md.               */
fails = 0
/* string patterns, p.132 */
parse value 'To be, or not to be?' with w1 ',' w2
call t 1, w1, 'To be'
call t 2, w2, ' or not to be?'
parse value 'To be, or not to be?' with w1 ',' w2 w3 w4
call t 3, w1, 'To be'
call t 4, w2, 'or'
call t 5, w3, 'not'
call t 6, w4, 'to be?'
/* no match: the pattern matches the end of the string, p.132 */
parse value 'To be' with w1 ',' w2
call t 7, w1, 'To be'
call t 8, w2, ''
/* variable pattern, p.132 */
comma = ','
parse value 'To be, or not to be?' with w1 (comma) w2 w3 w4
call t 9, w1, 'To be'
call t 10, w2, 'or'
call t 11, w3, 'not'
call t 12, w4, 'to be?'
/* literal patterns on the example string, p.134-135 */
s = 'This is  the data which, I think,  is scanned.'
parse var s w1 ',' w2 ',' rest
call t 13, w1, 'This is  the data which'
call t 14, w2, ' I think'
call t 15, rest, '  is scanned.'
parse var s w1 ',' w2 ',' w3 ',' rest
call t 16, w1, 'This is  the data which'
call t 17, w2, ' I think'
call t 18, w3, '  is scanned.'
call t 19, rest, ''
parse var s w1 w2 w3 rest ','
call t 20, w1, 'This'
call t 21, w2, 'is'
call t 22, w3, 'the'
call t 23, rest, 'data which'
parse var s w1 ' ' w2 ' ' w3 ' ' rest ','
call t 24, w1, 'This'
call t 25, w2, 'is'
call t 26, w3, ''
call t 27, rest, 'the data which'
/* variable pattern, p.135 */
input = 'L/look for/1 10'
parse var input verb 2 delim +1 string (delim) rest
call t 28, verb, 'L'
call t 29, delim, '/'
call t 30, string, 'look for'
call t 31, rest, '1 10'
/* a null pattern matches the end of the data, p.134 */
parse value 'abc' with p1 '' p2
call t 32, p1, 'abc'
call t 33, p2, ''
/* brexx parse.rexx 1, 2 */
parse value '(inval1 inval2) outval' with '(' in1 in2 ')' out
call t 34, in1, 'inval1'
call t 35, in2, 'inval2'
call t 36, out, ' outval'
parse value '()' with '(' inner1 inner2 ')'
call t 37, inner1, ''
call t 38, inner2, ''
/* brexx parse.rexx 3 */
parse value 'UNIX COMMAND ./xxx.r brexx /bin/bash',
  with a b c d e './' f g h i j
call t 39, a, 'UNIX'
call t 40, b, 'COMMAND'
call t 41, c d e, '  '
call t 42, f, 'xxx.r'
call t 43, g, 'brexx'
call t 44, h, '/bin/bash'
call t 45, i || j, ''
/* brexx parse.rexx 8, 9 */
parse value '11/09/1959' with Day '/' Month '/' Year
call t 46, Day Month Year, '11 09 1959'
parse value '11/09/1959' with Day . '/' Month . '/' Year .
call t 47, Day Month Year, '11 09 1959'
parse value '12345.678' with Integer '.' Decimal
call t 48, Integer, '12345'
call t 49, Decimal, '678'
/* brexx parse.rexx 15: compound targets */
parse value '<DL>,</DL>,<P><DT>,,<DD>,,',
  with  list.!dl.0.1 ',' list.!dl.0.2 ',' list.!dl.0.3 ',',
  list.!dl.0.4 ',' list.!dl.0.5 ',' list.!dl.0.6 ','
call t 50, list.!dl.0.1, '<DL>'
call t 51, list.!dl.0.2, '</DL>'
call t 52, list.!dl.0.3, '<P><DT>'
call t 53, list.!dl.0.4, ''
call t 54, list.!dl.0.5, '<DD>'
call t 55, list.!dl.0.6, ''
/* brexx parse.rexx 17, 18: control characters in the data */
sl = '/'
v = x2c('15')sl||x2c('09')sl||x2c('00')sl
v = v||x2c('01')sl||x2c('FE')sl||x2c('FF')
parse var v nl '/' tab '/' x00 '/' x01 '/' xfe '/' xff
call t 56, c2x(nl||tab||x00||x01||xfe||xff), '1509000001FEFF'
x00 = x2c('00')
v = 'before' || x00 || 'between' || x00 || 'after'
parse var v tagnest1 (x00) tntag (x00) tagnest2
call t 57, tagnest1, 'before'
call t 58, tntag, 'between'
call t 59, tagnest2, 'after'
/* brexx parse.rexx 16: only blanks delimit words, p.131 */
v = x2c('15') x2c('09') x2c('00')
parse var v nl tab x00
call t 60, c2x(nl) c2x(tab) c2x(x00), '15 09 00'
say 'PARSE2   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'PARSE2  ' right(n,3) 'PASS'
else do
  say 'PARSE2  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'PARSE2  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
