/* REXX -- DATE('C') conformance, SC28-1883-0 p.85-86               */
/* Cases: examples of SC28-1883-0 and brexx370 test/date.rexx       */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/language.md.                    */
fails = 0
/* Century, p.86: days since 1 Jan of the last year divisible by 100 */
ok = date('B') - date('C') + 1 == ,
  (left(date('S'),2)*100-1)*365 + (left(date('S'),2)*100-1)%4 - ,
  (left(date('S'),2)*100-1)%100 + (left(date('S'),2)*100-1)%400
call t 1, ok, '1'
ok = datatype(date('C'),'W') & left(date('C'),1) \== '0'
call t 2, ok, '1'
ok = date('C') >= date('D') & date('Century') == date('C')
call t 3, ok, '1'
say 'DATEC    done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'DATEC   ' right(n,3) 'PASS'
else do
  say 'DATEC   ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'DATEC   ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
