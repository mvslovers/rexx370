/* REXX -- ABS conformance, SC28-1883-0 p.78                        */
/* Cases: examples of SC28-1883-0 and brexx370 test/abs.rexx        */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/numeric.md.                     */
fails = 0
call t 1, abs('12.3'), '12.3'
call t 2, abs(' -0.307'), '0.307'
call t 3, abs(-12.345), '12.345'
call t 4, abs(12.345), '12.345'
call t 5, abs(-0.0), '0'
call t 6, abs(0.0), '0'
numeric digits 3
v = abs(-12.345)
numeric digits 9
call t 7, v, '12.3'
say 'ABS      done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'ABS     ' right(n,3) 'PASS'
else do
  say 'ABS     ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'ABS     ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
