/* REXX -- RIGHT conformance, SC28-1883-0 p.98                        */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/right.rexx (CMS-370-BREXX, Unlicense), expectations           */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, right('abc  d',8), '  abc  d'
call t 2, right('abc def',5), 'c def'
call t 3, right('12',5,'0'), '00012'
call t 4, right('',4), '    '
call t 5, right('foobar',0), ''
call t 6, right('foobar',3), 'bar'
call t 7, right('foobar',6), 'foobar'
call t 8, right('foobar',8), '  foobar'
call t 9, right('foobar',8,'*'), '**foobar'
call t 10, right('foobar',4,'*'), 'obar'
say 'RIGHT    done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'RIGHT   ' right(n,3) 'PASS'
else do
  say 'RIGHT   ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'RIGHT   ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
