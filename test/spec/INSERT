/* REXX -- INSERT conformance, SC28-1883-0 p.92                       */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/insert.rexx (CMS-370-BREXX, Unlicense), expectations          */
/* checked against the 1988 manual.                                   */
/* See internals/spec-tests/strings.md.                               */
fails = 0
call t 1, insert(' ','abcdef',3), 'abc def'
call t 2, insert('123','abc',5,6), 'abc  123   '
call t 3, insert('123','abc',5,6,'+'), 'abc++123+++'
call t 4, insert('123','abc'), '123abc'
call t 5, insert('123','abc',,5,'-'), '123--abc'
call t 6, insert('abc','def'), 'abcdef'
call t 7, insert('abc','def',2), 'deabcf'
call t 8, insert('abc','def',3), 'defabc'
call t 9, insert('abc','def',5), 'def  abc'
call t 10, insert('abc','def',5,,'*'), 'def**abc'
call t 11, insert('abc','def',5,4,'*'), 'def**abc*'
say 'INSERT   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'INSERT  ' right(n,3) 'PASS'
else do
  say 'INSERT  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'INSERT  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
