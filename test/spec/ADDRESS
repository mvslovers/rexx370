/* REXX -- ADDRESS conformance, SC28-1883-0 p.22-24, 28-29, 78-79   */
/* Cases: examples of SC28-1883-0 and brexx370 test/address.rexx    */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See internals/spec-tests/language.md.               */
fails = 0
/* the initial environment is TSO or MVS, p.22 and p.24 */
a0 = address()
call t 1, wordpos(a0, 'TSO MVS') > 0, '1'
/* a lasting change of destination, p.28 (no command is issued) */
address LINK
call t 2, address(), 'LINK'
/* no arguments: back to the previous environment, p.28 */
address
call t 3, address(), a0
address
call t 4, address(), 'LINK'
/* VALUE form, p.28 */
address value 'AT'||'TACH'
call t 5, address(), 'ATTACH'
/* environment as a literal string or a symbol taken as constant */
address 'TSO'
call t 6, address(), 'TSO'
address link
call t 7, address(), 'LINK'
/* ADDRESS settings are saved across routine calls, p.34 */
call sub
call t 8, result, 'LINK ATTACH'
call t 9, address(), 'LINK'
address
call t 10, address(), 'TSO'
address value a0
call t 11, address(), a0
/* VALUE omitted before a special character, p.28 */
address ('M'||'VS')
call t 12, address(), 'MVS'
say 'ADDRESS  done, failed:' fails
exit fails

sub: r = address()
address ATTACH
return r address()

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'ADDRESS ' right(n,3) 'PASS'
else do
  say 'ADDRESS ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'ADDRESS ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
