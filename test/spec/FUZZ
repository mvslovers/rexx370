/* REXX -- FUZZ conformance, SC28-1883-0 p.91                       */
/* Cases: examples of SC28-1883-0 and brexx370 test/fuzz.rexx       */
/* (CMS-370-BREXX, Unlicense), expectations checked against the     */
/* 1988 manual. See docs/spec-tests/numeric.md.                     */
fails = 0
call t 1, fuzz(), '0'
numeric fuzz 1
v = fuzz()
numeric fuzz 0
call t 2, v, '1'
numeric fuzz 1+1
v = fuzz()
numeric fuzz 0
call t 3, v, '2'
/* last: NUMERIC FUZZ without expression ends the exec today */
numeric fuzz 3
numeric fuzz
v = fuzz()
numeric fuzz 0
call t 4, v, '0'
say 'FUZZ     done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'FUZZ    ' right(n,3) 'PASS'
else do
  say 'FUZZ    ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'FUZZ    ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
