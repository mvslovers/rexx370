/* REXX -- TRANSLATE hex conformance, SC28-1883-0 p.104               */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/transla.rexx (CMS-370-BREXX, Unlicense), expectations         */
/* checked against the 1988 manual.                                   */
/* See internals/spec-tests/strings.md.                               */
fails = 0
want = 'Gpp'||'41'x||'Cb'||'9A'x
call te 1, translate('Foo Bar',xrange('01'x,'ff'x)), want
call t 2, translate('A'||'00'x,'x','00'x), 'Ax'
say 'TRANSLHX done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'TRANSLHX' right(n,3) 'PASS'
else do
  say 'TRANSLHX' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'TRANSLHX' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
