/* REXX -- INDEX conformance, SC28-1883-0 p.92                        */
/* Cases: examples of SC28-1883-0 and values derived                  */
/* from its rules (no brexx370 test exists).                          */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, index('abcdef','cd'), '3'
call t 2, index('abcdef','xd'), '0'
call t 3, index('abcdef','bc',3), '0'
call t 4, index('abcabc','bc',3), '5'
call t 5, index('abcabc','bc',6), '0'
say 'INDEX    done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'INDEX   ' right(n,3) 'PASS'
else do
  say 'INDEX   ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'INDEX   ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
