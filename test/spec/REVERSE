/* REXX -- REVERSE conformance, SC28-1883-0 p.98                      */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/reverse.rexx (CMS-370-BREXX, Unlicense), expectations         */
/* checked against the 1988 manual.                                   */
/* See internals/spec-tests/strings.md.                               */
fails = 0
call t 1, reverse('ABc.'), '.cBA'
call t 2, reverse('XYZ '), ' ZYX'
call t 3, reverse('Tranquility'), 'ytiliuqnarT'
call t 4, reverse('foobar'), 'raboof'
call t 5, reverse(''), ''
call t 6, reverse('fubar'), 'rabuf'
call t 7, reverse('f'), 'f'
call t 8, reverse(' foobar '), ' raboof '
say 'REVERSE  done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'REVERSE ' right(n,3) 'PASS'
else do
  say 'REVERSE ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'REVERSE ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
