/* REXX -- CENTRE/CENTER conformance, SC28-1883-0 p.81                */
/* Cases: examples of SC28-1883-0 and brexx370                        */
/* test/center.rexx (CMS-370-BREXX, Unlicense), expectations          */
/* checked against the 1988 manual.                                   */
/* See docs/spec-tests/strings.md.                                    */
fails = 0
call t 1, center(abc,7), '  ABC  '
call t 2, center(abc,8,'-'), '--ABC---'
call t 3, centre('The blue sky',8), 'e blue s'
call t 4, centre('The blue sky',7), 'e blue '
call t 5, centre(abc,7), '  ABC  '
call t 6, center('The blue sky',8), 'e blue s'
call t 7, center('The blue sky',7), 'e blue '
call t 8, center('****',8,'-'), '--****--'
call t 9, center('****',7,'-'), '-****--'
call t 10, center('*****',8,'-'), '-*****--'
call t 11, center('*****',7,'-'), '-*****-'
call t 12, center('12345678',4,'-'), '3456'
call t 13, center('12345678',5,'-'), '23456'
call t 14, center('1234567',4,'-'), '2345'
call t 15, center('1234567',5,'-'), '23456'
call t 16, centre(abc,8,'-'), '--ABC---'
call t 17, centre('****',8,'-'), '--****--'
call t 18, centre('****',7,'-'), '-****--'
call t 19, centre('*****',8,'-'), '-*****--'
call t 20, centre('*****',7,'-'), '-*****-'
call t 21, centre('12345678',4,'-'), '3456'
call t 22, centre('12345678',5,'-'), '23456'
call t 23, centre('1234567',4,'-'), '2345'
call t 24, centre('1234567',5,'-'), '23456'
say 'CENTER   done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison              */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'CENTER  ' right(n,3) 'PASS'
else do
  say 'CENTER  ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                             */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'CENTER  ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
