/* REXX -- ARITHNEG conformance, SC28-1883-0 p.143-144              */
/* Cases: examples and rules of SC28-1883-0, expectations           */
/* derived from the 1988 manual only.                               */
/* See internals/spec-tests/numeric.md.                             */
fails = 0
/* power with a negative exponent (split from ARITH, see doc) */
numeric digits 5
v = 2**-3
numeric digits 9
call t 1, v, '0.125'
call t 2, 2**-1, '0.5'
call t 3, (-2)**-3, '-0.125'
say 'ARITHNEG done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison            */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'ARITHNEG' right(n,3) 'PASS'
else do
  say 'ARITHNEG' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                           */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'ARITHNEG' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
