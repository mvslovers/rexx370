/* REXX -- B2X, extension (not in SC28-1883-0)                      */
/* Expected values follow TSO/E REXX on z/OS; see                   */
/* docs/extensions.md. Confirmed on z/OS 2026-09-30.               */
fails = 0
call t 1, b2x('11000011'), 'C3'
call t 2, b2x('10111'), '17'
call t 3, b2x('101'), '5'
call t 4, b2x('1 1111 0000'), '1F0'
call t 5, x2d(b2x('10111')), '23'
call t 6, b2x(''), ''
say 'B2X      done, failed:' fails
exit fails

/* t: case number, result, expected -- strict comparison             */
t: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if got == want then say 'B2X     ' right(n,3) 'PASS'
else do
  say 'B2X     ' right(n,3) 'FAIL got <'got'> want <'want'>'
  fails = fails + 1
end
return

/* te: as t, but only on an EBCDIC system                            */
te: procedure expose fails
n = arg(1); got = arg(2); want = arg(3)
if c2x(' ') \== '40' then do
  say 'B2X     ' right(n,3) 'SKIP (EBCDIC only)'
  return
end
call t n, got, want
return
